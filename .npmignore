# 编译产物不进包：setup.mjs 会在目标机重新编译。
# 宿主的 DLL 引用的是本机 EPLAN 的程序集，跨机器拷贝必然崩。
native/host/bin/
native/bridge/bin/

# 依赖装包时再装
node_modules/

# 打包目录、导出件
dist/
output/

# 测试只发自检要跑的那几个（INSTALL 让用户跑它们）
test/*
!test/smoke-all.mjs
!test/check-docs.mjs
!test/foreground.ps1

# 生成出来的引导脚本带时间戳，目标机自己生成
native/script/EplanMcpBootstrap-*.cs
native/script/EplanMcpBootstrap.install.cs

# 开发期备份，不进包
_backup/

# 本机路径配置由 setup.mjs 在目标机重新生成
server/eplan.config.json
